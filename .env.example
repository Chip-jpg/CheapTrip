# ============================================================
# Travel Deal Intelligence Engine — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your credentials.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Anthropic (AI formatting layer) ---
ANTHROPIC_API_KEY=your_anthropic_key_here
# Model and timeout for the optional alert polish
# AI_MODEL=claude-haiku-4-5
# AI_TIMEOUT_SECONDS=15

# --- Skyscanner RapidAPI ---
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_SKYSCANNER_HOST=skyscanner50.p.rapidapi.com
# Check the "Endpoints" tab in your RapidAPI console if you get 404s from Skyscanner
RAPIDAPI_SKYSCANNER_ENDPOINT=/api/v1/searchFlights
# Skyscanner is opt-in (small RapidAPI quotas); calls are capped per cycle
# ENABLE_SKYSCANNER=false
# SKYSCANNER_MAX_CALLS_PER_CYCLE=20

# --- Currency Exchange API ---
# Free tier: https://exchangerate-api.com
EXCHANGE_RATE_API_KEY=your_exchangerate_api_key_here

# --- Storage ---
DATABASE_URL=sqlite+aiosqlite:///./data/travel_deals.db

# --- Scheduler ---
SCRAPE_INTERVAL_MINUTES=90
DIGEST_HOUR=8
DIGEST_MINUTE=0
# Time zone for the digest schedule (IANA name)
TIMEZONE=Europe/Rome

# --- Alert Thresholds ---
EUROPE_TRIP_MAX_EUR=120
LONGHAUL_TRIP_MAX_EUR=450
HOTEL_DISCOUNT_MIN_PCT=60
FLIGHT_DISCOUNT_MIN_PCT=60
INSTANT_ALERTS_PER_HOUR=5

# --- Search budgets (searches per cycle, per source) ---
# The planner rotates through destinations and dates across cycles.
# GOOGLE_FLIGHTS_CALLS_PER_CYCLE=20
# BOOKING_CALLS_PER_CYCLE=5
# Minimum booking confidence (LOW / MEDIUM / HIGH) for an instant alert
BOOKING_CONFIDENCE_MIN_FOR_INSTANT=MEDIUM

# --- Scraper Overrides ---
# Scrapers disabled by default due to anti-bot protections (Cloudflare, JS SPA).
# Enable only if you have a proxy or headless browser configured.
# (Read from this file since B08; they used to need real environment variables.)
# ENABLE_SECRET_FLYING=false
# ENABLE_GOING=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/engine.log
