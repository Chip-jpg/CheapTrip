# ============================================================
# Travel Deal Intelligence Engine — Environment Configuration
# ============================================================
# Copy this file to .env, fill in your credentials, then run `python main.py doctor`.
# Empty values leave that feature off.

# --- Telegram ---
# Required to receive alerts (see docs/telegram_setup.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Anthropic (alert polish + reading PiratinViaggio deal posts) ---
# Recommended: https://console.anthropic.com (empty = no alert polish, no post reading)
ANTHROPIC_API_KEY=
# Model and timeout for the AI calls
# AI_MODEL=claude-haiku-4-5
# AI_TIMEOUT_SECONDS=15
# PiratinViaggio posts are read by Claude when a key is set; each post once, then cached
# ENABLE_PIRATINVIAGGIO=true
# AI_EXTRACTION_MAX_POSTS_PER_CYCLE=30

# --- Skyscanner RapidAPI ---
RAPIDAPI_KEY=
RAPIDAPI_SKYSCANNER_HOST=skyscanner50.p.rapidapi.com
# Check the "Endpoints" tab in your RapidAPI console if you get 404s from Skyscanner
RAPIDAPI_SKYSCANNER_ENDPOINT=/api/v1/searchFlights
# Skyscanner is opt-in (small RapidAPI quotas); calls are capped per cycle
# ENABLE_SKYSCANNER=false
# SKYSCANNER_MAX_CALLS_PER_CYCLE=20

# --- Ryanair (public fare API, no key needed) ---
# ENABLE_RYANAIR=true
# Site locale / point of sale as language-country. Default: the `market` preference,
# else derived from your first home airport's country (MXP → it-it, LGW → en-gb)
# RYANAIR_MARKET=it-it

# --- Travelpayouts / Aviasales Data API (optional, free token) ---
# https://www.travelpayouts.com → Tools → API. Leave empty to disable the source.
# TRAVELPAYOUTS_TOKEN=
# Optional affiliate marker appended to Aviasales links
# TRAVELPAYOUTS_MARKER=

# --- Currency Exchange API ---
# Free tier: https://exchangerate-api.com
EXCHANGE_RATE_API_KEY=

# --- Storage ---
DATABASE_URL=sqlite+aiosqlite:///./data/travel_deals.db

# --- Scheduler ---
SCRAPE_INTERVAL_MINUTES=90
DIGEST_HOUR=8
DIGEST_MINUTE=0
# Time zone for the digest schedule (IANA name)
TIMEZONE=Europe/Rome

# --- Alert Thresholds ---
# Flat backstops: round trips at or under these prices always alert instantly.
# Everything else alerts instantly only when it is well below its route's usual price.
EUROPE_TRIP_MAX_EUR=25
LONGHAUL_TRIP_MAX_EUR=250
# % below a route's usual price (same trip length and month, earlier cycles) = anomaly
PRICE_ANOMALY_MIN_DROP_PCT=35
HOTEL_DISCOUNT_MIN_PCT=60
FLIGHT_DISCOUNT_MIN_PCT=60
INSTANT_ALERTS_PER_HOUR=5

# --- Search budgets (searches per cycle, per source) ---
# The planner rotates through destinations and dates across cycles.
# GOOGLE_FLIGHTS_CALLS_PER_CYCLE=6
# Pause Google Flights this long after it rate-limits or shows a bot check
# GOOGLE_FLIGHTS_COOLDOWN_HOURS=3
# RYANAIR_CALLS_PER_CYCLE=30
# TRAVELPAYOUTS_CALLS_PER_CYCLE=30
# BOOKING_CALLS_PER_CYCLE=5
# Minimum booking confidence (LOW / MEDIUM / HIGH) for an instant alert
BOOKING_CONFIDENCE_MIN_FOR_INSTANT=MEDIUM

# --- Scraper Overrides ---
# Scrapers disabled by default due to anti-bot protections (Cloudflare, JS SPA).
# Enable only if you have a proxy or headless browser configured.
# (Read from this file since B08; they used to need real environment variables.)
# ENABLE_SECRET_FLYING=false
# Hotel scrapers: Booking.com (AWS WAF blocks plain HTTP) and Google Hotels (dates cannot be set yet)
# ENABLE_BOOKING_HTML=false
# ENABLE_GOOGLE_HOTELS=false
# ENABLE_GOING=false
# holidaypirates.com is the UK edition (GBP packages from UK airports)
# ENABLE_HOLIDAY_PIRATES=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/engine.log
